{
  "entities": {
    "UserProfilePublic": {
      "title": "UserProfilePublic",
      "description": "Public account root document establishing user workspace ownership for Master Gate checks without exposing PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the workspace owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the signed-in profile header.",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar URL from Google Auth.",
          "maxLength": 512
        },
        "role": {
          "type": "string",
          "description": "Account role; locked to member on client creation.",
          "enum": ["member"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "photoURL", "role", "createdAt", "updatedAt"]
    },
    "UserProfilePrivate": {
      "title": "UserProfilePrivate",
      "description": "Isolated private user PII document (email) restricted strictly to the owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified account email address.",
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "OfficeDiaryEntryDoc": {
      "title": "OfficeDiaryEntryDoc",
      "description": "Daily Office Diary entry synced to Firestore per user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique diary entry identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the entry owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateIso": {
          "type": "string",
          "description": "Calendar ISO date (YYYY-MM-DD).",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "dateLabel": {
          "type": "string",
          "description": "Formatted display date label.",
          "minLength": 1,
          "maxLength": 48
        },
        "timeLabel": {
          "type": "string",
          "description": "Formatted time label.",
          "minLength": 1,
          "maxLength": 24
        },
        "title": {
          "type": "string",
          "description": "Diary entry title.",
          "minLength": 1,
          "maxLength": 180
        },
        "content": {
          "type": "string",
          "description": "Markdown or plain-text office diary body.",
          "minLength": 1,
          "maxLength": 12000
        },
        "category": {
          "type": "string",
          "description": "Diary classification tag.",
          "enum": ["Focus", "Decision", "Blocker", "Note"]
        },
        "tags": {
          "type": "array",
          "description": "Bounded tag strings (max 12)."
        },
        "attachmentNames": {
          "type": "array",
          "description": "Bounded attachment filename list (max 12)."
        },
        "createdIso": {
          "type": "string",
          "format": "date-time",
          "description": "ISO creation string.",
          "maxLength": 40
        },
        "updatedIso": {
          "type": "string",
          "format": "date-time",
          "description": "ISO update string.",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "dateIso",
        "dateLabel",
        "timeLabel",
        "title",
        "content",
        "category",
        "tags",
        "attachmentNames",
        "createdIso",
        "updatedIso",
        "createdAt",
        "updatedAt"
      ]
    },
    "BackgroundTaskDoc": {
      "title": "BackgroundTaskDoc",
      "description": "Scheduled continuous Cloud AI background agentic task synced per user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of task owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Short task title.",
          "minLength": 1,
          "maxLength": 180
        },
        "prompt": {
          "type": "string",
          "description": "Objective prompt for the background agent.",
          "minLength": 1,
          "maxLength": 4000
        },
        "cloudModelId": {
          "type": "string",
          "description": "Selected Cloud AI model identifier.",
          "enum": ["claude-3-7-sonnet", "gemini-2-5-pro", "gpt-4o", "grok-3"]
        },
        "cloudModelLabel": {
          "type": "string",
          "description": "Display name of Cloud AI model.",
          "minLength": 1,
          "maxLength": 64
        },
        "cloudProviderLabel": {
          "type": "string",
          "description": "Cloud provider label.",
          "minLength": 1,
          "maxLength": 64
        },
        "intervalId": {
          "type": "string",
          "description": "Schedule cadence identifier.",
          "enum": ["15s", "1m", "5m", "hourly"]
        },
        "intervalLabel": {
          "type": "string",
          "description": "Human-readable interval label.",
          "minLength": 1,
          "maxLength": 48
        },
        "intervalMs": {
          "type": "number",
          "description": "Cadence interval in milliseconds."
        },
        "status": {
          "type": "string",
          "description": "Task execution state (archived is terminal).",
          "enum": ["running", "paused", "archived"]
        },
        "ragEnabled": {
          "type": "boolean",
          "description": "Whether CoreData RAG grounding is enabled."
        },
        "ragStrategyId": {
          "type": "string",
          "description": "Active RAG retrieval strategy.",
          "enum": ["hybrid-rrf", "agentic", "graph-rag", "corrective", "multimodal"]
        },
        "attachmentNames": {
          "type": "array",
          "description": "Bounded attachment names (max 12)."
        },
        "runCount": {
          "type": "number",
          "description": "Completed execution cycle count."
        },
        "createdAtIso": {
          "type": "string",
          "description": "ISO creation string.",
          "maxLength": 40
        },
        "lastRunIso": {
          "type": "string",
          "description": "ISO timestamp of last execution or empty string.",
          "maxLength": 40
        },
        "nextRunIso": {
          "type": "string",
          "description": "ISO timestamp of next scheduled execution.",
          "maxLength": 40
        },
        "latestOutput": {
          "type": "string",
          "description": "Latest synthesized output summary.",
          "maxLength": 16000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "prompt",
        "cloudModelId",
        "cloudModelLabel",
        "cloudProviderLabel",
        "intervalId",
        "intervalLabel",
        "intervalMs",
        "status",
        "ragEnabled",
        "ragStrategyId",
        "attachmentNames",
        "runCount",
        "createdAtIso",
        "lastRunIso",
        "nextRunIso",
        "latestOutput",
        "createdAt",
        "updatedAt"
      ]
    },
    "CoreDataDoc": {
      "title": "CoreDataDoc",
      "description": "Cloud-synced CoreData managed document metadata for NotebookLM and RAG retrieval.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of document owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "managedObjectId": {
          "type": "string",
          "description": "CoreData managed object URI.",
          "minLength": 1,
          "maxLength": 200
        },
        "cloudKitRecordName": {
          "type": "string",
          "description": "Sync record identifier.",
          "minLength": 1,
          "maxLength": 160
        },
        "entityName": {
          "type": "string",
          "description": "CoreData entity identifier.",
          "enum": ["CDDocument"]
        },
        "title": {
          "type": "string",
          "description": "Document filename or title.",
          "minLength": 1,
          "maxLength": 200
        },
        "format": {
          "type": "string",
          "description": "Parsed document format.",
          "enum": ["PDF", "TXT", "EPUB", "Markdown", "Image", "Audio", "Note"]
        },
        "assetKind": {
          "type": "string",
          "description": "Asset classification.",
          "enum": ["document", "image", "audio"]
        },
        "sizeKB": {
          "type": "number",
          "description": "File size in kilobytes."
        },
        "chunkCount": {
          "type": "number",
          "description": "Vector chunk count."
        },
        "embeddingDim": {
          "type": "number",
          "description": "Embedding vector dimension."
        },
        "dateAdded": {
          "type": "string",
          "description": "Date added display string.",
          "minLength": 1,
          "maxLength": 48
        },
        "updatedIso": {
          "type": "string",
          "description": "ISO sync string.",
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "description": "Document summary.",
          "maxLength": 1500
        },
        "contentExcerpt": {
          "type": "string",
          "description": "Truncated extracted text excerpt for cross-device hydration.",
          "maxLength": 16000
        },
        "tags": {
          "type": "array",
          "description": "Bounded document tags (max 15)."
        },
        "syncState": {
          "type": "string",
          "description": "Cloud sync status.",
          "enum": ["synced", "local"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "managedObjectId",
        "cloudKitRecordName",
        "entityName",
        "title",
        "format",
        "assetKind",
        "sizeKB",
        "chunkCount",
        "embeddingDim",
        "dateAdded",
        "updatedIso",
        "summary",
        "contentExcerpt",
        "tags",
        "syncState",
        "createdAt",
        "updatedAt"
      ]
    },
