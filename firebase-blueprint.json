        },
        "enableOfficeDiary": {
          "type": "boolean",
          "description": "Whether Office Diary sub-tab is enabled inside Workspace."
        },
        "enableScoutFeature": {
          "type": "boolean",
          "description": "Whether Scout Web Search is enabled inside opened Meeting Detail screens."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
